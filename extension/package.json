{
  "name": "edulcni",
  "displayName": "edulcni",
  "description": "Render competitive programming templates from the bundled catalog.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:edulcni.insertHeader",
    "onCommand:edulcni.segtree",
    "onCommand:edulcni.compressUnique",
    "onCommand:edulcni.input",
    "onCommand:edulcni.connectedComponents",
    "onCommand:edulcni.berlekampMassey",
    "onCommand:edulcni.sparseTable"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "library/**",
    "README.md",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "edulcni.insertHeader",
        "title": "edulcni"
      },
      {
        "command": "edulcni.segtree",
        "title": "edulcni: segtree — Global"
      },
      {
        "command": "edulcni.compressUnique",
        "title": "edulcni: compress_unique — Inline"
      },
      {
        "command": "edulcni.input",
        "title": "edulcni: input — Inline"
      },
      {
        "command": "edulcni.connectedComponents",
        "title": "edulcni: connected_components — Global"
      },
      {
        "command": "edulcni.berlekampMassey",
        "title": "edulcni: berlekamp_massey — Global"
      },
      {
        "command": "edulcni.sparseTable",
        "title": "edulcni: sparse_table — Global"
      }
    ]
  },
  "scripts": {
    "sync-library": "node ./scripts/sync-library.mjs",
    "build": "npm run sync-library && tsc -p .",
    "test": "npm run build && node ../tools/generate-solver-examples.mjs --check && npm run build-archive && node ./test/core.test.js",
    "test:visualization": "EDULCNI_ACTIVE_TESTS=1 npm test",
    "generate:examples": "npm run build && node ../tools/generate-solver-examples.mjs",
    "check:examples": "npm run build && node ../tools/generate-solver-examples.mjs --check",
    "test:examples": "npm run check:examples && node ../tools/check-solver-examples.mjs",
    "test:examples:visualization": "EDULCNI_ACTIVE_EXAMPLES=1 npm run test:examples",
    "build-archive": "node ../tools/build-archive-site.mjs",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
