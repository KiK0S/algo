{{valueType}} neutral() {
  return numeric_limits<{{valueType}}>::lowest();
}

{{valueType}} make_node({{valueType}} value) {
  return value;
}

{{valueType}} merge({{valueType}} a, {{valueType}} b) {
  return max(a, b);
}

vector<{{valueType}}> t;
{{#if rangeAdd}}
vector<{{valueType}}> lazy_add;
{{/if}}
{{#if rangeAssign}}
vector<{{valueType}}> lazy_set;
vector<char> lazy_has_set;
{{/if}}

void init_segtree(int n) {
  t.assign(4 * max(1, n), neutral());
{{#if rangeAdd}}
  lazy_add.assign(4 * max(1, n), {{valueType}}(0));
{{/if}}
{{#if rangeAssign}}
  lazy_set.assign(4 * max(1, n), {{valueType}}(0));
  lazy_has_set.assign(4 * max(1, n), 0);
{{/if}}
  EDULCNI_VIS(edulcni::live::segment_tree("segtree.tree", n, t));
  EDULCNI_STEP("Maximum segment tree initialized");
}

{{#if rangeAssign}}
void apply_set(int v, int tl, int tr, {{valueType}} value) {
  t[v] = value;
  lazy_has_set[v] = 1;
  lazy_set[v] = value;
{{#if rangeAdd}}
  lazy_add[v] = {{valueType}}(0);
{{/if}}
}
{{/if}}

{{#if rangeAdd}}
void apply_add(int v, int tl, int tr, {{valueType}} delta) {
  t[v] += delta;
{{#if rangeAssign}}
  if (lazy_has_set[v]) {
    lazy_set[v] += delta;
  } else {
    lazy_add[v] += delta;
  }
{{else}}
  lazy_add[v] += delta;
{{/if}}
}
{{/if}}

{{#if hasLazy}}
void push(int v, int tl, int tr) {
  if (tl == tr) return;
  int tm = (tl + tr) / 2;
{{#if rangeAssign}}
  if (lazy_has_set[v]) {
    apply_set(v * 2, tl, tm, lazy_set[v]);
    apply_set(v * 2 + 1, tm + 1, tr, lazy_set[v]);
    lazy_has_set[v] = 0;
  }
{{/if}}
{{#if rangeAdd}}
  if (lazy_add[v] != {{valueType}}(0)) {
    apply_add(v * 2, tl, tm, lazy_add[v]);
    apply_add(v * 2 + 1, tm + 1, tr, lazy_add[v]);
    lazy_add[v] = {{valueType}}(0);
  }
{{/if}}
}
{{/if}}

void build(int v, int tl, int tr, const vector<{{valueType}}>& a) {
  if (tl == tr) {
    t[v] = make_node(a[tl]);
    return;
  }
  int tm = (tl + tr) / 2;
  build(v * 2, tl, tm, a);
  build(v * 2 + 1, tm + 1, tr, a);
  t[v] = merge(t[v * 2], t[v * 2 + 1]);
  EDULCNI_VIS(v == 1 ? (edulcni::live::segment_tree("segtree.tree", tr - tl + 1, t), edulcni::live::step("Maximum segment tree built")) : static_cast<void>(0));
}

{{valueType}} get(int v, int tl, int tr, int l, int r) {
  if (tl > r || tr < l) return neutral();
  if (l <= tl && tr <= r) return t[v];
{{#if hasLazy}}
  push(v, tl, tr);
{{/if}}
  int tm = (tl + tr) / 2;
  return merge(get(v * 2, tl, tm, l, r), get(v * 2 + 1, tm + 1, tr, l, r));
}

{{#if pointSet}}
void point_set(int v, int tl, int tr, int pos, {{valueType}} value) {
  if (tl == tr) {
    t[v] = make_node(value);
    return;
  }
{{#if hasLazy}}
  push(v, tl, tr);
{{/if}}
  int tm = (tl + tr) / 2;
  if (pos <= tm) point_set(v * 2, tl, tm, pos, value);
  else point_set(v * 2 + 1, tm + 1, tr, pos, value);
  t[v] = merge(t[v * 2], t[v * 2 + 1]);
  EDULCNI_VIS(v == 1 ? (edulcni::live::segment_tree("segtree.tree", tr - tl + 1, t), edulcni::live::step("Maximum segment tree updated a point")) : static_cast<void>(0));
}
{{/if}}

{{#if pointAdd}}
void point_add(int v, int tl, int tr, int pos, {{valueType}} delta) {
  if (tl == tr) {
    t[v] += delta;
    return;
  }
{{#if hasLazy}}
  push(v, tl, tr);
{{/if}}
  int tm = (tl + tr) / 2;
  if (pos <= tm) point_add(v * 2, tl, tm, pos, delta);
  else point_add(v * 2 + 1, tm + 1, tr, pos, delta);
  t[v] = merge(t[v * 2], t[v * 2 + 1]);
  EDULCNI_VIS(v == 1 ? (edulcni::live::segment_tree("segtree.tree", tr - tl + 1, t), edulcni::live::step("Maximum segment tree added at a point")) : static_cast<void>(0));
}
{{/if}}

{{#if rangeAdd}}
void range_add(int v, int tl, int tr, int l, int r, {{valueType}} delta) {
  if (tl > r || tr < l) return;
  if (l <= tl && tr <= r) {
    apply_add(v, tl, tr, delta);
    return;
  }
{{#if hasLazy}}
  push(v, tl, tr);
{{/if}}
  int tm = (tl + tr) / 2;
  range_add(v * 2, tl, tm, l, r, delta);
  range_add(v * 2 + 1, tm + 1, tr, l, r, delta);
  t[v] = merge(t[v * 2], t[v * 2 + 1]);
  EDULCNI_VIS(v == 1 ? (edulcni::live::segment_tree("segtree.tree", tr - tl + 1, t), edulcni::live::step("Maximum segment tree added over a range")) : static_cast<void>(0));
}
{{/if}}

{{#if rangeAssign}}
void range_assign(int v, int tl, int tr, int l, int r, {{valueType}} value) {
  if (tl > r || tr < l) return;
  if (l <= tl && tr <= r) {
    apply_set(v, tl, tr, value);
    return;
  }
{{#if hasLazy}}
  push(v, tl, tr);
{{/if}}
  int tm = (tl + tr) / 2;
  range_assign(v * 2, tl, tm, l, r, value);
  range_assign(v * 2 + 1, tm + 1, tr, l, r, value);
  t[v] = merge(t[v * 2], t[v * 2 + 1]);
  EDULCNI_VIS(v == 1 ? (edulcni::live::segment_tree("segtree.tree", tr - tl + 1, t), edulcni::live::step("Maximum segment tree assigned over a range")) : static_cast<void>(0));
}
{{/if}}
