// Adapted from xeppelin-kactl PolygonCut.h (Ulf Lundstrom), CC0.
inline std::vector<GeometryPoint<long double>> cut_polygon_left(
		const std::vector<GeometryPoint<long double>>& polygon,
		GeometryPoint<long double> line_start,
		GeometryPoint<long double> line_end) {
	std::vector<GeometryPoint<long double>> result;
	if (polygon.empty()) return result;
	auto side = [&](auto point) { return (line_end - line_start).cross(point - line_start); };
	for (int i = 0; i < static_cast<int>(polygon.size()); ++i) {
		auto current = polygon[i];
		auto previous = polygon[(i + polygon.size() - 1) % polygon.size()];
		long double current_side = side(current), previous_side = side(previous);
		if ((current_side >= 0) != (previous_side >= 0)) {
			auto edge = current - previous;
			long double denominator = (line_end - line_start).cross(edge);
			long double parameter = (previous - line_start).cross(edge) / denominator;
			result.push_back(line_start + (line_end - line_start) * parameter);
		}
		if (current_side >= 0) result.push_back(current);
	}
	return result;
}
