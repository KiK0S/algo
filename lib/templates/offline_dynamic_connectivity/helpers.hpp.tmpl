enum class DynamicConnectivityOperationType { add_edge, remove_edge, connected };

struct DynamicConnectivityOperation {
  DynamicConnectivityOperationType type;
  int u;
  int v;
};

class OfflineDynamicConnectivity {
 private:
  class RollbackDsu {
   public:
    explicit RollbackDsu(int vertex_count) : parent_(vertex_count, -1) {}

    int find(int vertex) const {
      while (parent_[vertex] >= 0) vertex = parent_[vertex];
      return vertex;
    }

    bool same(int a, int b) const { return find(a) == find(b); }

    bool unite(int a, int b) {
      a = find(a);
      b = find(b);
      if (a == b) return false;
      if (parent_[a] > parent_[b]) std::swap(a, b);
      history_.push_back({a, parent_[a]});
      history_.push_back({b, parent_[b]});
      parent_[a] += parent_[b];
      parent_[b] = a;
      return true;
    }

    int snapshot() const { return static_cast<int>(history_.size()); }

    void rollback(int snapshot) {
      while (static_cast<int>(history_.size()) > snapshot) {
        const auto [vertex, old_parent] = history_.back();
        history_.pop_back();
        parent_[vertex] = old_parent;
      }
    }

   private:
    std::vector<int> parent_;
    std::vector<std::pair<int, int>> history_;
  };

 public:
  OfflineDynamicConnectivity(int vertex_count,
                             std::vector<DynamicConnectivityOperation> operations)
      : vertex_count_(vertex_count), operations_(std::move(operations)),
        tree_(std::max(1, 4 * static_cast<int>(operations_.size()))) {}

  std::vector<bool> solve() {
    build_intervals();
    RollbackDsu dsu(vertex_count_);
    std::vector<bool> answers;
    EDULCNI_VIS(edulcni::live::value("dynamic_connectivity.operations", operations_.size()));
    EDULCNI_STEP("Offline dynamic connectivity initialized");
    if (!operations_.empty()) dfs(1, 0, static_cast<int>(operations_.size()), dsu, answers);
    EDULCNI_VIS(edulcni::live::array("dynamic_connectivity.answers", answers));
    EDULCNI_STEP("Offline dynamic connectivity completed");
    return answers;
  }

 private:
  using Edge = std::pair<int, int>;

  int vertex_count_;
  std::vector<DynamicConnectivityOperation> operations_;
  std::vector<std::vector<Edge>> tree_;

  static Edge normalize_edge(int u, int v) {
    if (u > v) std::swap(u, v);
    return {u, v};
  }

  void add_interval(int node, int left, int right, int query_left,
                    int query_right, Edge edge) {
    if (query_right <= left || right <= query_left) return;
    if (query_left <= left && right <= query_right) {
      tree_[node].push_back(edge);
      return;
    }
    const int middle = (left + right) / 2;
    add_interval(node * 2, left, middle, query_left, query_right, edge);
    add_interval(node * 2 + 1, middle, right, query_left, query_right, edge);
  }

  void build_intervals() {
    const int q = static_cast<int>(operations_.size());
    for (auto& edges : tree_) edges.clear();
    std::map<Edge, std::vector<int>> active;
    for (int time = 0; time < q; ++time) {
      const auto& operation = operations_[time];
      const Edge edge = normalize_edge(operation.u, operation.v);
      if (operation.type == DynamicConnectivityOperationType::add_edge) {
        active[edge].push_back(time);
      } else if (operation.type == DynamicConnectivityOperationType::remove_edge) {
        auto it = active.find(edge);
        if (it != active.end() && !it->second.empty()) {
          const int start = it->second.back();
          it->second.pop_back();
          add_interval(1, 0, q, start, time, edge);
        }
      }
    }
    for (const auto& [edge, starts] : active)
      for (int start : starts) add_interval(1, 0, q, start, q, edge);
  }

  void dfs(int node, int left, int right, RollbackDsu& dsu,
           std::vector<bool>& answers) {
    const int snapshot = dsu.snapshot();
    for (const auto& [u, v] : tree_[node]) dsu.unite(u, v);
    EDULCNI_VIS(edulcni::live::edges(
        "dynamic_connectivity.interval_edges", vertex_count_, tree_[node]));
    EDULCNI_VIS(edulcni::live::array(
        "dynamic_connectivity.interval", std::vector<int>{left, right}));
    EDULCNI_STEP("Dynamic connectivity enters a time interval");
    if (right - left == 1) {
      const auto& operation = operations_[left];
      if (operation.type == DynamicConnectivityOperationType::connected)
        answers.push_back(dsu.same(operation.u, operation.v));
      EDULCNI_VIS(edulcni::live::array("dynamic_connectivity.answers", answers));
      EDULCNI_STEP("Dynamic connectivity processes an operation");
    } else {
      const int middle = (left + right) / 2;
      dfs(node * 2, left, middle, dsu, answers);
      dfs(node * 2 + 1, middle, right, dsu, answers);
    }
    dsu.rollback(snapshot);
    EDULCNI_STEP("Dynamic connectivity rolls back an interval");
  }
};
