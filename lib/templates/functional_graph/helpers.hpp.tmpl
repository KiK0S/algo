struct FunctionalGraphDecomposition {
	std::vector<std::vector<int>> cycles;
	std::vector<int> cycle_id;
	std::vector<int> cycle_position;
	std::vector<int> cycle_entry;
	std::vector<int> distance_to_cycle;
};

inline FunctionalGraphDecomposition functional_graph_decomposition(
		const std::vector<int>& successor) {
	const int n = static_cast<int>(successor.size());
	FunctionalGraphDecomposition result;
	result.cycle_id.assign(n, -1);
	result.cycle_position.assign(n, -1);
	result.cycle_entry.assign(n, -1);
	result.distance_to_cycle.assign(n, 0);

	std::vector<int> indegree(n, 0);
	for (int to : successor) ++indegree[to];
	std::vector<int> removed_order;
	std::vector<int> queue;
	for (int vertex = 0; vertex < n; ++vertex) {
		if (indegree[vertex] == 0) queue.push_back(vertex);
	}
	for (int index = 0; index < static_cast<int>(queue.size()); ++index) {
		int vertex = queue[index];
		removed_order.push_back(vertex);
		if (--indegree[successor[vertex]] == 0) {
			queue.push_back(successor[vertex]);
		}
	}

	for (int start = 0; start < n; ++start) {
		if (indegree[start] == 0 || result.cycle_id[start] != -1) continue;
		const int id = static_cast<int>(result.cycles.size());
		result.cycles.push_back({});
		int vertex = start;
		do {
			result.cycle_id[vertex] = id;
			result.cycle_position[vertex] =
				static_cast<int>(result.cycles.back().size());
			result.cycle_entry[vertex] = vertex;
			result.cycles.back().push_back(vertex);
			vertex = successor[vertex];
		} while (vertex != start);
	}

	for (int index = static_cast<int>(removed_order.size()); index-- > 0; ) {
		int vertex = removed_order[index];
		int to = successor[vertex];
		result.cycle_id[vertex] = result.cycle_id[to];
		result.cycle_entry[vertex] = result.cycle_entry[to];
		result.distance_to_cycle[vertex] = result.distance_to_cycle[to] + 1;
	}
	return result;
}

class FunctionalGraph {
 public:
	explicit FunctionalGraph(const std::vector<int>& successor)
			: successor_(successor), decomposition_(functional_graph_decomposition(successor)) {
		const int n = static_cast<int>(successor_.size());
		jump_.assign(64, std::vector<int>(n));
		if (n == 0) return;
		jump_[0] = successor_;
		for (int level = 1; level < 64; ++level) {
			for (int vertex = 0; vertex < n; ++vertex) {
				jump_[level][vertex] = jump_[level - 1][jump_[level - 1][vertex]];
			}
		}
	}

	int jump(int vertex, unsigned long long steps) const {
		for (int level = 0; level < 64; ++level) {
			if ((steps >> level) & 1ULL) vertex = jump_[level][vertex];
		}
		return vertex;
	}

	long long distance_if_reachable(int from, int to) const {
		if (decomposition_.cycle_id[from] != decomposition_.cycle_id[to]) return -1;
		const int from_depth = decomposition_.distance_to_cycle[from];
		const int to_depth = decomposition_.distance_to_cycle[to];
		if (to_depth > 0) {
			if (from_depth < to_depth) return -1;
			const int difference = from_depth - to_depth;
			return jump(from, difference) == to ? difference : -1;
		}
		const int entry = jump(from, from_depth);
		const int cycle_id = decomposition_.cycle_id[to];
		const int cycle_size = static_cast<int>(decomposition_.cycles[cycle_id].size());
		int around = decomposition_.cycle_position[to] -
			decomposition_.cycle_position[entry];
		if (around < 0) around += cycle_size;
		return static_cast<long long>(from_depth) + around;
	}

	const FunctionalGraphDecomposition& decomposition() const { return decomposition_; }
	const std::vector<int>& successor() const { return successor_; }

 private:
	std::vector<int> successor_;
	FunctionalGraphDecomposition decomposition_;
	std::vector<std::vector<int>> jump_;
};
