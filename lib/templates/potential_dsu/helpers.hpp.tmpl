template <class Value>
class PotentialDsu {
 public:
  explicit PotentialDsu(int n = 0) : parent_(n, -1), to_parent_(n, Value{}) {}

  std::pair<int, Value> find(int vertex) {
    if (parent_[vertex] < 0) return {vertex, Value{}};
    auto [root, value] = find(parent_[vertex]);
    to_parent_[vertex] += value;
    parent_[vertex] = root;
    return {root, to_parent_[vertex]};
  }

  // Adds the constraint potential(b) - potential(a) = difference.
  bool unite(int a, int b, Value difference) {
    auto [root_a, value_a] = find(a);
    auto [root_b, value_b] = find(b);
    if (root_a == root_b) return value_b - value_a == difference;
    Value root_difference = difference + value_a - value_b;
    if (parent_[root_a] > parent_[root_b]) {
      std::swap(root_a, root_b);
      root_difference = -root_difference;
    }
    parent_[root_a] += parent_[root_b];
    parent_[root_b] = root_a;
    to_parent_[root_b] = root_difference;
    return true;
  }

  std::optional<Value> difference(int a, int b) {
    auto [root_a, value_a] = find(a);
    auto [root_b, value_b] = find(b);
    if (root_a != root_b) return std::nullopt;
    return value_b - value_a;
  }

 private:
  std::vector<int> parent_;
  std::vector<Value> to_parent_;
};
