inline std::vector<long long> continued_fraction(long long numerator,
                                                 long long denominator) {
  std::vector<long long> coefficients;
  while (denominator != 0) {
    long long quotient = numerator / denominator;
    long long remainder = numerator % denominator;
    if (remainder < 0) {
      remainder += std::abs(denominator);
      quotient -= denominator > 0 ? 1 : -1;
    }
    coefficients.push_back(quotient);
    numerator = denominator;
    denominator = remainder;
  }
  return coefficients;
}

inline std::vector<std::pair<__int128, __int128>> continued_fraction_convergents(
    const std::vector<long long>& coefficients) {
  std::vector<std::pair<__int128, __int128>> result;
  __int128 previous_numerator = 0, numerator = 1;
  __int128 previous_denominator = 1, denominator = 0;
  for (long long coefficient : coefficients) {
    const __int128 next_numerator = coefficient * numerator + previous_numerator;
    const __int128 next_denominator = coefficient * denominator + previous_denominator;
    previous_numerator = numerator;
    numerator = next_numerator;
    previous_denominator = denominator;
    denominator = next_denominator;
    result.push_back({numerator, denominator});
  }
  return result;
}

inline std::vector<long long> square_root_continued_fraction(long long value) {
  if (value < 0) return {};
  long long root = static_cast<long long>(std::sqrt(static_cast<long double>(value)));
  while ((__int128)(root + 1) * (root + 1) <= value) ++root;
  while ((__int128)root * root > value) --root;
  if ((__int128)root * root == value) return {root};
  std::vector<long long> result{root};
  long long m = 0, denominator = 1, coefficient = root;
  do {
    m = denominator * coefficient - m;
    denominator = (value - m * m) / denominator;
    coefficient = (root + m) / denominator;
    result.push_back(coefficient);
  } while (coefficient != 2 * root);
  return result;
}

inline std::pair<__int128, __int128> pell_minimum_solution(long long value) {
  const std::vector<long long> fraction = square_root_continued_fraction(value);
  if (fraction.size() <= 1) return {0, 0};
  const int period = static_cast<int>(fraction.size()) - 1;
  const int terms = (period & 1) ? 2 * period : period;
  std::vector<long long> coefficients;
  coefficients.reserve(terms);
  coefficients.push_back(fraction[0]);
  for (int i = 1; i < terms; ++i)
    coefficients.push_back(fraction[1 + (i - 1) % period]);
  return continued_fraction_convergents(coefficients).back();
}
