class {{className}} {
 public:
  explicit {{className}}(int limit = 0) : limit_(0) { build(limit); }

  void build(int limit) {
    limit_ = (limit < 0 ? 0 : limit);
    lowest_prime_.assign(limit_ + 1, 0);
    lowest_prime_exponent_.assign(limit_ + 1, 0);
    prime_power_.assign(limit_ + 1, 1);
    phi_.assign(limit_ + 1, 0);
    mobius_.assign(limit_ + 1, 0);
    divisor_count_.assign(limit_ + 1, 0);
    divisor_sum_.assign(limit_ + 1, 0);
    primes_.clear();

    if (limit_ >= 1) {
      lowest_prime_[1] = 1;
      phi_[1] = 1;
      mobius_[1] = 1;
      divisor_count_[1] = 1;
      divisor_sum_[1] = 1;
    }

    for (int i = 2; i <= limit_; ++i) {
      if (lowest_prime_[i] == 0) {
        lowest_prime_[i] = i;
        lowest_prime_exponent_[i] = 1;
        prime_power_[i] = i;
        phi_[i] = i - 1;
        mobius_[i] = -1;
        divisor_count_[i] = 2;
        divisor_sum_[i] = saturated_add(1, static_cast<unsigned long long>(i));
        primes_.push_back(i);
      }
      for (int p : primes_) {
        const long long next = static_cast<long long>(i) * p;
        if (next > limit_ || p > lowest_prime_[i]) {
          break;
        }
        const int value = static_cast<int>(next);
        lowest_prime_[value] = p;
        if (p == lowest_prime_[i]) {
          lowest_prime_exponent_[value] = lowest_prime_exponent_[i] + 1;
          prime_power_[value] = prime_power_[i] * p;
          phi_[value] = phi_[i] * p;
          mobius_[value] = 0;
          divisor_count_[value] = saturated_multiply(
              divisor_count_[i] / (lowest_prime_exponent_[i] + 1),
              static_cast<unsigned long long>(lowest_prime_exponent_[value] + 1));
          const int coprime_part = i / prime_power_[i];
          divisor_sum_[value] = saturated_add(
              divisor_sum_[i],
              saturated_multiply(divisor_sum_[coprime_part],
                                 static_cast<unsigned long long>(prime_power_[value])));
        } else {
          lowest_prime_exponent_[value] = 1;
          prime_power_[value] = p;
          phi_[value] = phi_[i] * (p - 1);
          mobius_[value] = -mobius_[i];
          divisor_count_[value] = saturated_multiply(divisor_count_[i], 2);
          divisor_sum_[value] = saturated_multiply(
              divisor_sum_[i], static_cast<unsigned long long>(p) + 1);
        }
      }
    }
    EDULCNI_VIS(edulcni::live::array("linear_sieve.lowest_prime", lowest_prime_));
    EDULCNI_VIS(edulcni::live::array("linear_sieve.primes", primes_));
    EDULCNI_STEP("Linear sieve built");
  }

  int limit() const { return limit_; }

  const std::vector<int>& lowest_prime_exponents() const {
    return lowest_prime_exponent_;
  }
  const std::vector<long long>& phi_table() const { return phi_; }
  const std::vector<int>& mobius_table() const { return mobius_; }
  const std::vector<unsigned long long>& divisor_count_table() const {
    return divisor_count_;
  }
  const std::vector<unsigned long long>& divisor_sum_table() const {
    return divisor_sum_;
  }

  int lowest_prime_exponent_of(int value) const {
    return in_range(value) ? lowest_prime_exponent_[value] : 0;
  }
  long long phi_of(int value) const { return in_range(value) ? phi_[value] : 0; }
  int mobius_of(int value) const { return in_range(value) ? mobius_[value] : 0; }
  unsigned long long divisor_count_of(int value) const {
    return in_range(value) ? divisor_count_[value] : 0;
  }
  unsigned long long divisor_sum_of(int value) const {
    return in_range(value) ? divisor_sum_[value] : 0;
  }
{{#if includeLowestPrime}}

  const std::vector<int>& lowest_prime() const { return lowest_prime_; }

  int lowest_prime_of(int value) const {
    if (value < 0 || value > limit_) {
      return 0;
    }
    return lowest_prime_[value];
  }

  bool is_prime(int value) const {
    return value >= 2 && value <= limit_ && lowest_prime_[value] == value;
  }
{{/if}}
{{#if includePrimes}}

  const std::vector<int>& primes() const { return primes_; }
{{/if}}
{{#if includeFactorization}}

  std::vector<std::pair<int, int>> factorize(int value) const {
    std::vector<std::pair<int, int>> factors;
    if (value < 2 || value > limit_) {
      return factors;
    }

    int x = value;
    while (x > 1) {
      const int p = lowest_prime_[x];
      int exponent = 0;
      while (x % p == 0) {
        x /= p;
        ++exponent;
      }
      factors.push_back(std::make_pair(p, exponent));
    }
    EDULCNI_VIS(edulcni::live::array("linear_sieve.factorization", factors));
    EDULCNI_STEP("Linear sieve factorized a value");
    return factors;
  }
{{/if}}

 private:
  int limit_;
  std::vector<int> lowest_prime_;
  std::vector<int> lowest_prime_exponent_;
  std::vector<int> prime_power_;
  std::vector<long long> phi_;
  std::vector<int> mobius_;
  std::vector<unsigned long long> divisor_count_;
  std::vector<unsigned long long> divisor_sum_;
  std::vector<int> primes_;

  bool in_range(int value) const { return value >= 1 && value <= limit_; }

  static unsigned long long saturated_add(unsigned long long lhs,
                                          unsigned long long rhs) {
    const unsigned long long maximum =
        std::numeric_limits<unsigned long long>::max();
    return rhs > maximum - lhs ? maximum : lhs + rhs;
  }

  static unsigned long long saturated_multiply(unsigned long long lhs,
                                               unsigned long long rhs) {
    const unsigned long long maximum =
        std::numeric_limits<unsigned long long>::max();
    if (lhs == 0 || rhs == 0) return 0;
    return lhs > maximum / rhs ? maximum : lhs * rhs;
  }
};
{{#if includeLowestPrime}}

inline std::vector<int> {{lowestPrimeFunctionName}}(int limit) {
  {{className}} sieve(limit);
  return sieve.lowest_prime();
}
{{/if}}
{{#if includePrimes}}

inline std::vector<int> {{primesFunctionName}}(int limit) {
  {{className}} sieve(limit);
  return sieve.primes();
}
{{/if}}
