template <typename T>
struct is_text_output
	: bool_constant<
		is_same_v<decay_t<T>, string> ||
		is_same_v<decay_t<T>, char*> ||
		is_same_v<decay_t<T>, const char*>> {};

template <typename T, typename = void>
struct is_output_range : false_type {};

template <typename T>
struct is_output_range<T, void_t<
	decltype(begin(declval<const T&>())),
	decltype(end(declval<const T&>()))>>
	: bool_constant<!is_text_output<T>::value> {};

template <typename T, typename = void>
struct is_output_iterator : false_type {};

template <typename T>
struct is_output_iterator<T, void_t<
	typename iterator_traits<T>::iterator_category>> : true_type {};

template <typename T>
void write_value(ostream& output, bool& first, const T& value) {
	if constexpr (is_output_range<T>::value) {
		for (const auto& element : value) write_value(output, first, element);
	} else {
		output << (first ? "" : " ") << value;
		first = false;
	}
}

template <typename... Values>
ostream& write(const Values&... values) {
	bool first = true;
	(write_value(cout, first, values), ...);
	return cout << '\n';
}

template <typename Iterator,
		enable_if_t<is_output_iterator<Iterator>::value, int> = 0>
ostream& write(Iterator first, Iterator last) {
	bool first_value = true;
	for (; first != last; ++first) write_value(cout, first_value, *first);
	return cout << '\n';
}

