// Adapted from xeppelin-kactl Factor.h, MillerRabin.h, and ModMulLL.h, CC0.
inline unsigned long long factor_mod_multiply(
		unsigned long long first, unsigned long long second,
		unsigned long long modulus) {
	if (modulus == 0) return 0;
	return static_cast<unsigned long long>(
		static_cast<unsigned __int128>(first) * second % modulus);
}

inline unsigned long long factor_mod_power(
		unsigned long long base, unsigned long long exponent,
		unsigned long long modulus) {
	if (modulus == 0) return 0;
	unsigned long long result = 1 % modulus;
	while (exponent > 0) {
		if (exponent & 1ULL) result = factor_mod_multiply(result, base, modulus);
		base = factor_mod_multiply(base, base, modulus);
		exponent >>= 1;
	}
	return result;
}

inline bool factor_is_prime(unsigned long long value) {
	if (value < 2 || value % 6 % 4 != 1) return (value | 1ULL) == 3;
	static constexpr unsigned long long witnesses[] = {
		2, 325, 9375, 28178, 450775, 9780504, 1795265022
	};
	int shifts = __builtin_ctzll(value - 1);
	unsigned long long odd_part = (value - 1) >> shifts;
	for (auto witness : witnesses) {
		if (witness % value == 0) continue;
		auto current = factor_mod_power(witness % value, odd_part, value);
		int round = 0;
		while (round < shifts && current != 1 && current != value - 1) {
			current = factor_mod_multiply(current, current, value);
			++round;
		}
		if (current != value - 1 && round != 0) return false;
	}
	return true;
}

inline unsigned long long pollard_rho(unsigned long long value) {
	if (value % 2 == 0) return 2;
	static std::mt19937_64 generator(
		std::chrono::steady_clock::now().time_since_epoch().count());
	for (;;) {
		unsigned long long constant = std::uniform_int_distribution<unsigned long long>(1, value - 1)(generator);
		unsigned long long current = std::uniform_int_distribution<unsigned long long>(0, value - 1)(generator);
		unsigned long long other = current;
		unsigned long long divisor = 1;
		auto advance = [&](unsigned long long x) {
			return static_cast<unsigned long long>(
				(static_cast<unsigned __int128>(factor_mod_multiply(x, x, value)) +
				 constant) % value);
		};
		while (divisor == 1) {
			current = advance(current);
			other = advance(advance(other));
			unsigned long long difference = current > other ? current - other : other - current;
			divisor = std::gcd(difference, value);
		}
		if (divisor != value) return divisor;
	}
}

inline std::vector<unsigned long long> factorize_64(unsigned long long value) {
	std::vector<unsigned long long> factors;
	std::function<void(unsigned long long)> split = [&](unsigned long long current) {
		if (current <= 1) return;
		if (factor_is_prime(current)) {
			factors.push_back(current);
			return;
		}
		auto divisor = pollard_rho(current);
		split(divisor);
		split(current / divisor);
	};
	split(value);
	std::sort(factors.begin(), factors.end());
	return factors;
}

inline std::vector<unsigned long long> divisors_from_factorization(
		const std::vector<unsigned long long>& sorted_prime_factors) {
	std::vector<unsigned long long> divisors{1};
	for (int first = 0; first < static_cast<int>(sorted_prime_factors.size());) {
		int last = first;
		while (last < static_cast<int>(sorted_prime_factors.size()) &&
				sorted_prime_factors[last] == sorted_prime_factors[first]) {
			++last;
		}
		const std::size_t previous_size = divisors.size();
		unsigned long long power = 1;
		for (int exponent = 1; exponent <= last - first; ++exponent) {
			power *= sorted_prime_factors[first];
			for (std::size_t i = 0; i < previous_size; ++i) {
				divisors.push_back(divisors[i] * power);
			}
		}
		first = last;
	}
	std::sort(divisors.begin(), divisors.end());
	return divisors;
}

inline std::vector<unsigned long long> divisors_64(unsigned long long value) {
	assert(value > 0);
	return divisors_from_factorization(factorize_64(value));
}
