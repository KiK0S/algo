#ifndef EDULCNI_VIS
#define EDULCNI_VIS(...) ((void)0)
#endif
#ifndef EDULCNI_STEP
#define EDULCNI_STEP(...) ((void)0)
#endif

#ifdef LOCAL
template <class LocalQuery, class... Args>
decltype(auto) interactive_query(LocalQuery&& local_query, Args&&... args) {
  return std::forward<LocalQuery>(local_query)(std::forward<Args>(args)...);
}
#else
template <class LocalQuery, class... Args>
long long interactive_query(LocalQuery&&, Args&&... args) {
  std::cout << "?";
  ((std::cout << ' ' << args), ...);
  std::cout << std::endl;
  long long answer;
  std::cin >> answer;
  EDULCNI_VIS(edulcni::live::value("interactive.answer", answer));
  EDULCNI_STEP("Interactive answer received");
  return answer;
}
#endif

