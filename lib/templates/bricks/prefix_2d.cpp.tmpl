#ifndef EDULCNI_VIS
#define EDULCNI_VIS(...) ((void)0)
#endif
#ifndef EDULCNI_STEP
#define EDULCNI_STEP(...) ((void)0)
#endif

vector<vector<ll>> pref(n + 1, vector<ll>(m + 1));
forn(i, n) {
	forn(j, m) {
		pref[i + 1][j + 1] = pref[i + 1][j] + pref[i][j + 1] - pref[i][j] + a[i][j];
	}
	EDULCNI_VIS(edulcni::live::matrix("prefix_2d.source", a));
	EDULCNI_VIS(edulcni::live::matrix("prefix_2d.prefix", pref));
	EDULCNI_STEP("Two-dimensional prefix sums complete a row");
}
auto rect_sum = [&](int x1, int y1, int x2, int y2) {
	auto result = pref[x2][y2] - pref[x1][y2] - pref[x2][y1] + pref[x1][y1];
	EDULCNI_VIS(edulcni::live::array(
	    "prefix_2d.rectangle", std::vector<int>{x1, y1, x2, y2}));
	EDULCNI_VIS(edulcni::live::value("prefix_2d.result", result));
	EDULCNI_STEP("Rectangle sum queried");
	return result;
};
