vi p(n, -1), depth(n), sz(n, 1);
EDULCNI_VIS(edulcni::live::graph("dfs_tree.graph", g));
EDULCNI_STEP("DFS tree initialized");
auto dfs = [&](auto self, int v, int pr = -1) -> void {
	p[v] = pr;
	for (auto to : g[v]) {
		if (to == pr) continue;
		depth[to] = depth[v] + 1;
		self(self, to, v);
		sz[v] += sz[to];
	}
	EDULCNI_VIS(edulcni::live::forest("dfs_tree.forest", p));
	EDULCNI_VIS(edulcni::live::array("dfs_tree.depth", depth));
	EDULCNI_VIS(edulcni::live::array("dfs_tree.subtree_size", sz));
	EDULCNI_VIS(edulcni::live::value("dfs_tree.vertex", v));
	EDULCNI_STEP("DFS finishes a vertex");
};
dfs(dfs, 0);
