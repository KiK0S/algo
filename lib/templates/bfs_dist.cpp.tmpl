vi dist(n, -1);
queue<int> q;
dist[s] = 0;
q.push(s);
EDULCNI_VIS(edulcni::live::graph("bfs_dist.graph", g));
EDULCNI_VIS(edulcni::live::array("bfs_dist.distance", dist));
EDULCNI_VIS(edulcni::live::queue("bfs_dist.frontier", q));
EDULCNI_STEP("BFS initialized");
while (q.size()) {
	int v = q.front();
	q.pop();
	EDULCNI_VIS(edulcni::live::queue("bfs_dist.frontier", q));
	EDULCNI_VIS(edulcni::live::value("bfs_dist.vertex", v));
	EDULCNI_STEP("BFS visits a vertex");
	for (auto to : g[v]) {
		if (dist[to] != -1) continue;
		dist[to] = dist[v] + 1;
		q.push(to);
		EDULCNI_VIS(edulcni::live::array("bfs_dist.distance", dist));
		EDULCNI_VIS(edulcni::live::queue("bfs_dist.frontier", q));
		EDULCNI_STEP("BFS discovers a vertex");
	}
}
