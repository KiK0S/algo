template <typename T = unsigned, typename Sum = long long>
class WaveletMatrix {
 public:
  explicit WaveletMatrix(std::vector<T> values) {
    std::vector<Sum> weights(values.size(), Sum{1});
    build(std::move(values), std::move(weights));
  }

  WaveletMatrix(std::vector<T> values, std::vector<Sum> weights) {
    assert(values.size() == weights.size());
    build(std::move(values), std::move(weights));
  }

  int size() const { return size_; }

  T kth(int left, int right, int order) const {
    assert(valid_range(left, right) && 0 <= order && order < right - left);
    T answer{};
    for (int depth = 0; depth < levels_; ++depth) {
      int left_zeros = prefix_zero_[depth][left];
      int right_zeros = prefix_zero_[depth][right];
      int zeros = right_zeros - left_zeros;
      if (order < zeros) { left = left_zeros; right = right_zeros; }
      else {
        answer |= T(1) << (levels_ - 1 - depth);
        order -= zeros;
        left = zero_count_[depth] + left - left_zeros;
        right = zero_count_[depth] + right - right_zeros;
      }
    }
    return answer;
  }

  int count_less(int left, int right, T upper) const {
    assert(valid_range(left, right));
    int answer = 0;
    descend_less(left, right, upper, [&](int depth, int l, int r) {
      answer += prefix_zero_[depth][r] - prefix_zero_[depth][l];
    });
    return answer;
  }

  Sum sum_less(int left, int right, T upper) const {
    assert(valid_range(left, right));
    Sum answer{};
    descend_less(left, right, upper, [&](int depth, int l, int r) {
      int zl = prefix_zero_[depth][l], zr = prefix_zero_[depth][r];
      answer += prefix_value_sum_[depth][zr] - prefix_value_sum_[depth][zl];
    });
    return answer;
  }

  Sum weight_less(int left, int right, T upper) const {
    assert(valid_range(left, right));
    Sum answer{};
    descend_less(left, right, upper, [&](int depth, int l, int r) {
      int zl = prefix_zero_[depth][l], zr = prefix_zero_[depth][r];
      answer += prefix_weight_[depth][zr] - prefix_weight_[depth][zl];
    });
    return answer;
  }

  Sum sum_k_smallest(int left, int right, int count) const {
    assert(valid_range(left, right) && 0 <= count && count <= right - left);
    Sum answer{};
    for (int depth = 0; depth < levels_ && count > 0; ++depth) {
      int zl = prefix_zero_[depth][left], zr = prefix_zero_[depth][right];
      int zeros = zr - zl;
      if (count <= zeros) { left = zl; right = zr; }
      else {
        answer += prefix_value_sum_[depth][zr] - prefix_value_sum_[depth][zl];
        count -= zeros;
        left = zero_count_[depth] + left - zl;
        right = zero_count_[depth] + right - zr;
      }
    }
    if (count > 0) answer += Sum(count) * Sum(final_values_[left]);
    return answer;
  }

  // Smallest value whose inclusive cumulative nonnegative weight exceeds order.
  T weighted_kth(int left, int right, Sum order) const {
    assert(valid_range(left, right) && order >= Sum{} && order < range_weight(left, right));
    T answer{};
    for (int depth = 0; depth < levels_; ++depth) {
      int zl = prefix_zero_[depth][left], zr = prefix_zero_[depth][right];
      Sum zero_weight = prefix_weight_[depth][zr] - prefix_weight_[depth][zl];
      if (order < zero_weight) { left = zl; right = zr; }
      else {
        answer |= T(1) << (levels_ - 1 - depth);
        order -= zero_weight;
        left = zero_count_[depth] + left - zl;
        right = zero_count_[depth] + right - zr;
      }
    }
    return answer;
  }

  int frequency(int left, int right, T value) const {
    assert(valid_range(left, right));
    for (int depth = 0; depth < levels_; ++depth) {
      int zl = prefix_zero_[depth][left], zr = prefix_zero_[depth][right];
      if ((value >> (levels_ - 1 - depth)) & T(1)) {
        left = zero_count_[depth] + left - zl;
        right = zero_count_[depth] + right - zr;
      } else { left = zl; right = zr; }
    }
    return right - left;
  }

 private:
  int size_ = 0, levels_ = 0;
  std::vector<std::vector<int>> prefix_zero_;
  std::vector<std::vector<Sum>> prefix_value_sum_, prefix_weight_;
  std::vector<int> zero_count_;
  std::vector<T> final_values_;
  std::vector<Sum> original_weight_prefix_;

  bool valid_range(int left, int right) const { return 0 <= left && left <= right && right <= size_; }
  Sum range_weight(int left, int right) const { return original_weight_prefix_[right] - original_weight_prefix_[left]; }

  void build(std::vector<T> values, std::vector<Sum> weights) {
    static_assert(std::is_integral_v<T> && std::is_unsigned_v<T>);
    size_ = values.size(); levels_ = std::numeric_limits<T>::digits;
    original_weight_prefix_.assign(size_ + 1, Sum{});
    for (int i = 0; i < size_; ++i) {
      assert(weights[i] >= Sum{});
      original_weight_prefix_[i + 1] = original_weight_prefix_[i] + weights[i];
    }
    prefix_zero_.resize(levels_); prefix_value_sum_.resize(levels_);
    prefix_weight_.resize(levels_); zero_count_.resize(levels_);
    std::vector<T> next_values(size_); std::vector<Sum> next_weights(size_);
    for (int depth = 0; depth < levels_; ++depth) {
      int bit = levels_ - 1 - depth;
      auto& zeros = prefix_zero_[depth]; zeros.assign(size_ + 1, 0);
      for (int i = 0; i < size_; ++i) zeros[i + 1] = zeros[i] + (((values[i] >> bit) & T(1)) == 0);
      zero_count_[depth] = zeros.back();
      int zero = 0, one = zeros.back();
      for (int i = 0; i < size_; ++i) {
        int position = ((values[i] >> bit) & T(1)) ? one++ : zero++;
        next_values[position] = values[i]; next_weights[position] = weights[i];
      }
      auto& value_sum = prefix_value_sum_[depth]; value_sum.assign(size_ + 1, Sum{});
      auto& weight_sum = prefix_weight_[depth]; weight_sum.assign(size_ + 1, Sum{});
      for (int i = 0; i < size_; ++i) {
        value_sum[i + 1] = value_sum[i] + Sum(next_values[i]);
        weight_sum[i + 1] = weight_sum[i] + next_weights[i];
      }
      values.swap(next_values); weights.swap(next_weights);
    }
    final_values_ = std::move(values);
  }

  template<class TakeZeros>
  void descend_less(int left, int right, T upper, TakeZeros take_zeros) const {
    for (int depth = 0; depth < levels_; ++depth) {
      int zl = prefix_zero_[depth][left], zr = prefix_zero_[depth][right];
      if ((upper >> (levels_ - 1 - depth)) & T(1)) {
        take_zeros(depth, left, right);
        left = zero_count_[depth] + left - zl;
        right = zero_count_[depth] + right - zr;
      } else { left = zl; right = zr; }
    }
  }
};
