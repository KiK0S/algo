struct ConnectedComponentsResult {
	int count = 0;
	std::vector<int> component_of;
{{#if sizes}}
	std::vector<int> sizes;
{{/if}}
{{#if groups}}
	std::vector<std::vector<int>> groups;
{{/if}}
};

inline ConnectedComponentsResult connected_components(
		const std::vector<std::vector<int>>& graph) {
	const int n = static_cast<int>(graph.size());
{{#if weak}}
	std::vector<std::vector<int>> weak_graph = graph;
	for (int vertex = 0; vertex < n; ++vertex)
		for (int to : graph[vertex])
			if (to >= 0 && to < n) weak_graph[to].push_back(vertex);
	const auto& adjacency = weak_graph;
{{/if}}
{{#unless weak}}
	const auto& adjacency = graph;
{{/unless}}
	ConnectedComponentsResult result;
	result.component_of.assign(n, -1);
	std::vector<int> stack;
	for (int start = 0; start < n; ++start) {
		if (result.component_of[start] != -1) continue;
{{#if sizes}}
		result.sizes.push_back(0);
{{/if}}
{{#if groups}}
		result.groups.push_back({});
{{/if}}
		stack.push_back(start);
		result.component_of[start] = result.count;
		while (!stack.empty()) {
			int vertex = stack.back();
			stack.pop_back();
{{#if sizes}}
			++result.sizes.back();
{{/if}}
{{#if groups}}
			result.groups.back().push_back(vertex);
{{/if}}
			for (int to : adjacency[vertex]) {
				if (to < 0 || to >= n || result.component_of[to] != -1) continue;
				result.component_of[to] = result.count;
				stack.push_back(to);
			}
		}
		++result.count;
	}
	EDULCNI_VIS(edulcni::live::array("components.id", result.component_of));
	EDULCNI_STEP("Connected components computed");
	return result;
}
