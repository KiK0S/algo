struct ManacherRadii {
	std::vector<int> odd;
	std::vector<int> even;
};

template <typename Sequence>
ManacherRadii manacher(const Sequence& sequence) {
	const int n = static_cast<int>(sequence.size());
	ManacherRadii result{std::vector<int>(n), std::vector<int>(n)};
	for (int i = 0, left = 0, right = -1; i < n; ++i) {
		int radius = i > right ? 1 : std::min(result.odd[left + right - i], right - i + 1);
		while (i - radius >= 0 && i + radius < n && sequence[i - radius] == sequence[i + radius]) ++radius;
		result.odd[i] = radius;
		if (i + radius - 1 > right) left = i - radius + 1, right = i + radius - 1;
	}
	for (int i = 0, left = 0, right = -1; i < n; ++i) {
		int radius = i > right ? 0 : std::min(result.even[left + right - i + 1], right - i + 1);
		while (i - radius - 1 >= 0 && i + radius < n && sequence[i - radius - 1] == sequence[i + radius]) ++radius;
		result.even[i] = radius;
		if (i + radius - 1 > right) left = i - radius, right = i + radius - 1;
	}
	return result;
}
