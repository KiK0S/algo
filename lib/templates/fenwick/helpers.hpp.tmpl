{{#if sumOp}}
template <typename T>
struct FenwickSumOp {
  static constexpr bool kHasInverse = true;
  static constexpr bool kHasDescend = true;

  static T default_neutral() { return T(0); }
  static T combine(const T& lhs, const T& rhs) { return lhs + rhs; }
  static T inverse(const T& total, const T& prefix) { return total - prefix; }
  static bool descend_should_advance(const T& candidate, const T& target) {
    return candidate < target;
  }
};
{{/if}}

{{#if xorOp}}
template <typename T>
struct FenwickXorOp {
  static constexpr bool kHasInverse = true;
  static constexpr bool kHasDescend = false;

  static T default_neutral() { return T(0); }
  static T combine(const T& lhs, const T& rhs) { return lhs ^ rhs; }
  static T inverse(const T& total, const T& prefix) { return total ^ prefix; }
};
{{/if}}

{{#if maxOp}}
template <typename T>
struct FenwickMaxOp {
  static constexpr bool kHasInverse = false;
  static constexpr bool kHasDescend = true;

  static T default_neutral() { return T(); }
  static T combine(const T& lhs, const T& rhs) { return (lhs < rhs ? rhs : lhs); }
  static bool descend_should_advance(const T& candidate, const T& target) {
    return !(target < candidate);
  }
};
{{/if}}

