{{#if rangeSum}}
template <typename T>
class FenwickRange {
 public:
  explicit FenwickRange(int n = 0) : bit1_(n), bit2_(n) {}

  void reset(int n) {
    bit1_.reset(n);
    bit2_.reset(n);
    EDULCNI_STEP("Range Fenwick tree reset");
  }

  void add(int left, int right, const T& value) {
    add_prefix(left, value);
    add_prefix(right + 1, -value);
    EDULCNI_STEP("Range Fenwick tree updated");
  }

  T prefix(int idx) const {
    return bit1_.prefix(idx) * static_cast<T>(idx + 1) - bit2_.prefix(idx);
  }

  T sum(int left, int right) const {
    return prefix(right) - prefix(left - 1);
  }

 private:
  void add_prefix(int idx, const T& value) {
    if (idx >= bit1_.size()) {
      return;
    }
    bit1_.add(idx, value);
    bit2_.add(idx, value * static_cast<T>(idx));
  }

  FenwickSumTree<T> bit1_;
  FenwickSumTree<T> bit2_;
};
{{/if}}
