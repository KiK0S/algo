struct NttFormalPowerSeries {
  // Coefficients are residues modulo 998244353. Requested sizes and convolution
  // lengths must fit the modulus' 2^23 root of unity.
  static constexpr int mod = 998244353;
  static constexpr int primitive_root = 3;
  using Polynomial = std::vector<int>;

  static int power_mod(int base, long long exponent) {
    long long result = 1;
    for (long long value = base; exponent; exponent >>= 1, value = value * value % mod)
      if (exponent & 1) result = result * value % mod;
    return static_cast<int>(result);
  }

  static void transform(Polynomial& values, bool inverse) {
    const int size = static_cast<int>(values.size());
    for (int i = 1, j = 0; i < size; ++i) {
      int bit = size >> 1;
      for (; j & bit; bit >>= 1) j ^= bit;
      j ^= bit;
      if (i < j) std::swap(values[i], values[j]);
    }
    for (int length = 2; length <= size; length <<= 1) {
      int root = power_mod(primitive_root, (mod - 1) / length);
      if (inverse) root = power_mod(root, mod - 2);
      for (int start = 0; start < size; start += length) {
        long long factor = 1;
        for (int offset = 0; offset < length / 2; ++offset) {
          const int left = values[start + offset];
          const int right = static_cast<int>(factor * values[start + offset + length / 2] % mod);
          values[start + offset] = left + right < mod ? left + right : left + right - mod;
          values[start + offset + length / 2] = left - right >= 0 ? left - right : left - right + mod;
          factor = factor * root % mod;
        }
      }
    }
    if (inverse) {
      const int inverse_size = power_mod(size, mod - 2);
      for (int& value : values) value = static_cast<int>(1LL * value * inverse_size % mod);
    }
  }

  static Polynomial multiply(Polynomial left, Polynomial right, int size = -1) {
    if (left.empty() || right.empty() || size == 0) return {};
    const int full_result_size = static_cast<int>(left.size() + right.size() - 1);
    const int result_size = size < 0 ? full_result_size : std::min(size, full_result_size);
    left.resize(std::min(static_cast<int>(left.size()), result_size));
    right.resize(std::min(static_cast<int>(right.size()), result_size));
    // The transform must hold the full product of the trimmed operands. Using
    // only result_size slots would wrap discarded high coefficients into the
    // requested low prefix through cyclic convolution.
    const int needed_coefficients = static_cast<int>(left.size() + right.size() - 1);
    int transform_size = 1;
    while (transform_size < needed_coefficients) transform_size <<= 1;
    if (transform_size > (1 << 23)) return {};
    left.resize(transform_size);
    right.resize(transform_size);
    transform(left, false);
    transform(right, false);
    for (int i = 0; i < transform_size; ++i)
      left[i] = static_cast<int>(1LL * left[i] * right[i] % mod);
    transform(left, true);
    left.resize(result_size);
    return left;
  }

  static Polynomial inverse(const Polynomial& series, int size) {
    if (size <= 0) return {};
    if (size > (1 << 22)) return {};
    if (series.empty() || series[0] == 0) return {};
    Polynomial result{power_mod(series[0], mod - 2)};
    for (int length = 2; length / 2 < size; length <<= 1) {
      const int next_size = std::min(length, size);
      Polynomial prefix(std::min(next_size, static_cast<int>(series.size())));
      std::copy_n(series.begin(), prefix.size(), prefix.begin());
      Polynomial product = multiply(prefix, result, next_size);
      product.resize(next_size);
      for (int& value : product) value = value == 0 ? 0 : mod - value;
      product[0] = product[0] + 2 >= mod ? product[0] + 2 - mod : product[0] + 2;
      result = multiply(result, product, next_size);
      result.resize(next_size);
    }
    result.resize(size);
    return result;
  }

  static Polynomial derivative(const Polynomial& series) {
    if (series.size() < 2) return {};
    Polynomial result(series.size() - 1);
    for (int i = 1; i < static_cast<int>(series.size()); ++i)
      result[i - 1] = static_cast<int>(1LL * i * series[i] % mod);
    return result;
  }

  static Polynomial integral(const Polynomial& series) {
    Polynomial result(series.size() + 1);
    for (int i = 0; i < static_cast<int>(series.size()); ++i)
      result[i + 1] = static_cast<int>(1LL * series[i] * power_mod(i + 1, mod - 2) % mod);
    return result;
  }

  static Polynomial logarithm(const Polynomial& series, int size) {
    if (size <= 0) return {};
    if (size > (1 << 22)) return {};
    if (series.empty() || series[0] != 1) return {};
    Polynomial result = integral(multiply(derivative(series), inverse(series, size), size - 1));
    result.resize(size);
    return result;
  }

  static Polynomial exponential(const Polynomial& series, int size) {
    if (size <= 0) return {};
    if (size > (1 << 22)) return {};
    if (!series.empty() && series[0] != 0) return {};
    Polynomial result{1};
    for (int length = 2; length / 2 < size; length <<= 1) {
      const int next_size = std::min(length, size);
      Polynomial correction = logarithm(result, next_size);
      correction.resize(next_size);
      for (int i = 0; i < next_size; ++i) {
        const int expected = i < static_cast<int>(series.size()) ? series[i] : 0;
        correction[i] = expected - correction[i];
        if (correction[i] < 0) correction[i] += mod;
      }
      if (++correction[0] == mod) correction[0] = 0;
      result = multiply(result, correction, next_size);
      result.resize(next_size);
    }
    result.resize(size);
    return result;
  }

  static Polynomial power(const Polynomial& series, long long exponent, int size) {
    if (size <= 0 || exponent < 0) return {};
    if (size > (1 << 22)) return {};
    Polynomial zero(size);
    if (exponent == 0) { zero[0] = 1; return zero; }
    int leading = 0;
    while (leading < static_cast<int>(series.size()) && series[leading] == 0) ++leading;
    if (leading == static_cast<int>(series.size()) || (__int128)leading * exponent >= size) return zero;
    const int shift = static_cast<int>(leading * exponent);
    const int scale = series[leading];
    const int inverse_scale = power_mod(scale, mod - 2);
    Polynomial normalized(series.begin() + leading, series.end());
    for (int& value : normalized) value = static_cast<int>(1LL * value * inverse_scale % mod);
    Polynomial logged = logarithm(normalized, size - shift);
    const int reduced_exponent = static_cast<int>(exponent % mod);
    for (int& value : logged) value = static_cast<int>(1LL * value * reduced_exponent % mod);
    Polynomial result = exponential(logged, size - shift);
    const int scale_power = power_mod(scale, exponent);
    for (int& value : result) value = static_cast<int>(1LL * value * scale_power % mod);
    result.insert(result.begin(), shift, 0);
    result.resize(size);
    return result;
  }

  // Returns either square root (the other is its negation), or an empty vector.
  // For 998244353, Tonelli-Shanks supplies the constant-term root.
  static int modular_square_root(int value) {
    if (value == 0) return 0;
    if (power_mod(value, (mod - 1) / 2) != 1) return -1;
    int q = mod - 1, shifts = 0;
    while ((q & 1) == 0) q >>= 1, ++shifts;
    int non_residue = 2;
    while (power_mod(non_residue, (mod - 1) / 2) == 1) ++non_residue;
    int x = power_mod(value, (q + 1) / 2);
    int residue = power_mod(value, q);
    int base = power_mod(non_residue, q);
    while (residue != 1) {
      int index = 1;
      int squared = static_cast<int>(1LL * residue * residue % mod);
      while (squared != 1) squared = static_cast<int>(1LL * squared * squared % mod), ++index;
      const int factor = power_mod(base, 1LL << (shifts - index - 1));
      x = static_cast<int>(1LL * x * factor % mod);
      base = static_cast<int>(1LL * factor * factor % mod);
      residue = static_cast<int>(1LL * residue * base % mod);
      shifts = index;
    }
    return x;
  }

  static Polynomial square_root(const Polynomial& series, int size) {
    if (size <= 0) return {};
    if (size > (1 << 22)) return {};
    int leading = 0;
    while (leading < static_cast<int>(series.size()) && series[leading] == 0) ++leading;
    if (leading == static_cast<int>(series.size())) return Polynomial(size);
    if (leading & 1) return {};
    if (leading > 0) {
      if (leading / 2 >= size) return Polynomial(size);
      Polynomial shifted(series.begin() + leading, series.end());
      Polynomial result = square_root(shifted, size - leading / 2);
      if (result.empty()) return {};
      result.insert(result.begin(), leading / 2, 0);
      result.resize(size);
      return result;
    }
    const int root = modular_square_root(series[0]);
    if (root < 0) return {};
    Polynomial result{root};
    const int inverse_two = (mod + 1) / 2;
    for (int length = 2; length / 2 < size; length <<= 1) {
      const int next_size = std::min(length, size);
      Polynomial prefix(std::min(next_size, static_cast<int>(series.size())));
      std::copy_n(series.begin(), prefix.size(), prefix.begin());
      Polynomial quotient = multiply(prefix, inverse(result, next_size), next_size);
      result.resize(next_size);
      quotient.resize(next_size);
      for (int i = 0; i < next_size; ++i)
        result[i] = static_cast<int>(1LL * (result[i] + quotient[i]) * inverse_two % mod);
    }
    result.resize(size);
    return result;
  }
};
