{{#if custom}}
{{valueType}} {{customCombineName}}({{valueType}} lhs, {{valueType}} rhs) {
  // TODO: replace with an idempotent associative operation.
  return lhs < rhs ? lhs : rhs;
}

{{/if}}
vector<vector<{{valueType}}>> {{tableName}};

void {{buildName}}(const vector<{{valueType}}>& values) {
  const int n = static_cast<int>(values.size());
  {{ensureLogName}}(n);
  {{tableName}}.clear();
  if (n == 0) {
    EDULCNI_VIS(edulcni::live::matrix("sparse_table.table", {{tableName}}));
    EDULCNI_STEP("Sparse table built");
    return;
  }

  {{tableName}}.assign({{logName}}[n] + 1, vector<{{valueType}}>());
  {{tableName}}[0] = values;
  for (int level = 1; level < static_cast<int>({{tableName}}.size()); ++level) {
    const int len = 1 << level;
    const int half = len >> 1;
    {{tableName}}[level].assign(n - len + 1, {{valueType}}());
    for (int i = 0; i + len <= n; ++i) {
      const {{valueType}}& lhs = {{tableName}}[level - 1][i];
      const {{valueType}}& rhs = {{tableName}}[level - 1][i + half];
      {{tableName}}[level][i] = ({{#if min}}lhs < rhs ? lhs : rhs{{/if}}{{#if max}}lhs < rhs ? rhs : lhs{{/if}}{{#if gcd}}gcd(lhs, rhs){{/if}}{{#if bitAnd}}lhs & rhs{{/if}}{{#if bitOr}}lhs | rhs{{/if}}{{#if custom}}{{customCombineName}}(lhs, rhs){{/if}});
    }
    EDULCNI_VIS(edulcni::live::matrix("sparse_table.table", {{tableName}}));
    EDULCNI_STEP("Sparse table built a level");
  }
  EDULCNI_STEP("Sparse table built");
}

{{valueType}} {{queryName}}(int left, int right) {
  const int n = {{tableName}}.empty() ? 0 : static_cast<int>({{tableName}}[0].size());
  if (n == 0 || left > right || right < 0 || left >= n) {
    return {{valueType}}();
  }
  if (left < 0) {
    left = 0;
  }
  if (right >= n) {
    right = n - 1;
  }

  const int level = {{logName}}[right - left + 1];
  const {{valueType}}& lhs = {{tableName}}[level][left];
  const {{valueType}}& rhs = {{tableName}}[level][right - (1 << level) + 1];
  const {{valueType}} result = {{#if min}}lhs < rhs ? lhs : rhs{{/if}}{{#if max}}lhs < rhs ? rhs : lhs{{/if}}{{#if gcd}}gcd(lhs, rhs){{/if}}{{#if bitAnd}}lhs & rhs{{/if}}{{#if bitOr}}lhs | rhs{{/if}}{{#if custom}}{{customCombineName}}(lhs, rhs){{/if}};
  EDULCNI_VIS(edulcni::live::array("sparse_table.query", std::vector<{{valueType}}>{lhs, rhs, result}));
  EDULCNI_STEP("Sparse table answered a query");
  return result;
}
