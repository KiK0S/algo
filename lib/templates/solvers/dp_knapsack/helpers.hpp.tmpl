#ifndef EDULCNI_VIS
#define EDULCNI_VIS(...) ((void)0)
#endif
#ifndef EDULCNI_STEP
#define EDULCNI_STEP(...) ((void)0)
#endif

inline long long knapsack_zero_one(const std::vector<int>& weight,
                                   const std::vector<long long>& value,
                                   int capacity) {
  std::vector<long long> dp(capacity + 1, 0);
  EDULCNI_VIS(edulcni::live::array("knapsack.weight", weight));
  EDULCNI_VIS(edulcni::live::array("knapsack.value", value));
  EDULCNI_VIS(edulcni::live::array("knapsack.dp", dp));
  EDULCNI_STEP("Zero-one knapsack initialized");
  for (int i = 0; i < static_cast<int>(weight.size()); ++i) {
    for (int sum = capacity; sum >= weight[i]; --sum)
      dp[sum] = std::max(dp[sum], dp[sum - weight[i]] + value[i]);
    EDULCNI_VIS(edulcni::live::array("knapsack.dp", dp));
    EDULCNI_VIS(edulcni::live::value("knapsack.item", i));
    EDULCNI_STEP("Zero-one knapsack processes an item");
  }
  return *std::max_element(dp.begin(), dp.end());
}

inline long long knapsack_unbounded(const std::vector<int>& weight,
                                    const std::vector<long long>& value,
                                    int capacity) {
  std::vector<long long> dp(capacity + 1, 0);
  EDULCNI_VIS(edulcni::live::array("knapsack.weight", weight));
  EDULCNI_VIS(edulcni::live::array("knapsack.value", value));
  EDULCNI_VIS(edulcni::live::array("knapsack.dp", dp));
  EDULCNI_STEP("Unbounded knapsack initialized");
  for (int i = 0; i < static_cast<int>(weight.size()); ++i) {
    for (int sum = weight[i]; sum <= capacity; ++sum)
      dp[sum] = std::max(dp[sum], dp[sum - weight[i]] + value[i]);
    EDULCNI_VIS(edulcni::live::array("knapsack.dp", dp));
    EDULCNI_VIS(edulcni::live::value("knapsack.item", i));
    EDULCNI_STEP("Unbounded knapsack processes an item");
  }
  return *std::max_element(dp.begin(), dp.end());
}
