struct TestGenerator {
  std::mt19937_64 rng;

  explicit TestGenerator(uint64_t seed = std::chrono::steady_clock::now().time_since_epoch().count())
      : rng(seed) {}

  template <class T>
  T generate_integer(T low, T high) {
    return std::uniform_int_distribution<T>(low, high)(rng);
  }

  template <class T>
  std::vector<T> generate_array(int n, T low, T high) {
    std::vector<T> result(n);
    for (auto& value : result) value = generate_integer<T>(low, high);
    return result;
  }

  std::vector<int> generate_permutation(int n, int first = 0) {
    std::vector<int> result(n);
    std::iota(result.begin(), result.end(), first);
    std::shuffle(result.begin(), result.end(), rng);
    return result;
  }

  uint64_t generate_mask(int bits) {
    if (bits <= 0) return 0;
    if (bits >= 64) return rng();
    return generate_integer<uint64_t>(0, (uint64_t(1) << bits) - 1);
  }

  std::vector<uint64_t> generate_masks(int count, int bits) {
    std::vector<uint64_t> result(count);
    for (auto& value : result) value = generate_mask(bits);
    return result;
  }

  std::string generate_string(int n, std::string_view alphabet = "abcdefghijklmnopqrstuvwxyz") {
    assert(!alphabet.empty());
    std::string result(n, ' ');
    for (char& ch : result) ch = alphabet[generate_integer<int>(0, int(alphabet.size()) - 1)];
    return result;
  }

  std::vector<std::pair<int, int>> generate_tree(int n, int first = 0) {
    if (n <= 1) return {};
    auto order = generate_permutation(n, first);
    std::vector<std::pair<int, int>> edges;
    edges.reserve(n - 1);
    for (int i = 1; i < n; ++i) {
      int parent = order[generate_integer<int>(0, i - 1)];
      edges.push_back({parent, order[i]});
    }
    std::shuffle(edges.begin(), edges.end(), rng);
    return edges;
  }

  std::vector<std::pair<int, int>> generate_graph(int n, int m, bool connected = false, int first = 0) {
    int maximum = n * (n - 1) / 2;
    assert(0 <= m && m <= maximum);
    assert(!connected || n == 0 || m >= n - 1);
    std::set<std::pair<int, int>> selected;
    if (connected) {
      for (auto [u, v] : generate_tree(n, first)) {
        if (u > v) std::swap(u, v);
        selected.insert({u, v});
      }
    }
    while (int(selected.size()) < m) {
      int u = generate_integer(first, first + n - 1);
      int v = generate_integer(first, first + n - 1);
      if (u == v) continue;
      if (u > v) std::swap(u, v);
      selected.insert({u, v});
    }
    std::vector<std::pair<int, int>> edges(selected.begin(), selected.end());
    std::shuffle(edges.begin(), edges.end(), rng);
    return edges;
  }
};
