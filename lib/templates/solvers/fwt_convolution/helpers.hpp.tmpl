#ifndef EDULCNI_VIS
#define EDULCNI_VIS(...) ((void)0)
#endif
#ifndef EDULCNI_STEP
#define EDULCNI_STEP(...) ((void)0)
#endif

enum class BitwiseConvolution { xor_convolution, and_convolution, or_convolution };

inline long long fwt_mod_pow(long long base, long long exponent, long long mod) {
  long long result = 1;
  while (exponent > 0) {
    if (exponent & 1LL) result = result * base % mod;
    base = base * base % mod;
    exponent >>= 1LL;
  }
  return result;
}

inline void fwt_transform(std::vector<long long>& a, BitwiseConvolution kind,
                          bool inverse, long long mod = 998244353) {
  const int n = static_cast<int>(a.size());
  EDULCNI_VIS(edulcni::live::array("fwt.values", a));
  EDULCNI_STEP("Fast Walsh-Hadamard transform initialized");
  for (int len = 1; len < n; len <<= 1) {
    for (int start = 0; start < n; start += len << 1) {
      for (int i = 0; i < len; ++i) {
        long long& x = a[start + i];
        long long& y = a[start + len + i];
        if (kind == BitwiseConvolution::xor_convolution) {
          const long long u = x, v = y;
          x = (u + v) % mod;
          y = (u - v + mod) % mod;
        } else if (kind == BitwiseConvolution::and_convolution) {
          if (!inverse) x = (x + y) % mod;
          else x = (x - y + mod) % mod;
        } else {
          if (!inverse) y = (x + y) % mod;
          else y = (y - x + mod) % mod;
        }
      }
    }
    EDULCNI_VIS(edulcni::live::array("fwt.values", a));
    EDULCNI_VIS(edulcni::live::value("fwt.block_size", len << 1));
    EDULCNI_STEP("Fast Walsh-Hadamard stage completed");
  }
  if (inverse && kind == BitwiseConvolution::xor_convolution) {
    const long long inv_n = fwt_mod_pow(n, mod - 2, mod);
    for (long long& x : a) x = x * inv_n % mod;
    EDULCNI_VIS(edulcni::live::array("fwt.values", a));
    EDULCNI_STEP("Inverse transform normalized");
  }
}

inline std::vector<long long> bitwise_convolution(
    std::vector<long long> a, std::vector<long long> b,
    BitwiseConvolution kind, long long mod = 998244353) {
  int n = 1;
  while (n < static_cast<int>(std::max(a.size(), b.size()))) n <<= 1;
  a.resize(n);
  b.resize(n);
  fwt_transform(a, kind, false, mod);
  fwt_transform(b, kind, false, mod);
  for (int i = 0; i < n; ++i) a[i] = a[i] * b[i] % mod;
  EDULCNI_VIS(edulcni::live::array("fwt.product", a));
  EDULCNI_STEP("Pointwise transform product computed");
  fwt_transform(a, kind, true, mod);
  return a;
}
