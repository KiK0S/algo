template <typename Cost>
inline std::pair<Cost, std::vector<std::pair<int, int>>> substring_partition_dp(
    int n, Cost infinity, const std::function<Cost(int, int)>& segment_cost) {
  std::vector<Cost> dp(n + 1, infinity);
  std::vector<int> parent(n + 1, -1);
  dp[0] = Cost{};
  for (int right = 1; right <= n; ++right)
    for (int left = 0; left < right; ++left) {
      const Cost candidate = dp[left] + segment_cost(left, right);
      if (candidate < dp[right]) dp[right] = candidate, parent[right] = left;
    }
  std::vector<std::pair<int, int>> parts;
  for (int right = n; right > 0 && parent[right] != -1; right = parent[right])
    parts.push_back({parent[right], right});
  std::reverse(parts.begin(), parts.end());
  return {dp[n], parts};
}

inline int longest_palindromic_subsequence(const std::string& text) {
  const int n = static_cast<int>(text.size());
  if (n == 0) return 0;
  std::vector<std::vector<int>> dp(n, std::vector<int>(n));
  for (int left = n - 1; left >= 0; --left) {
    dp[left][left] = 1;
    for (int right = left + 1; right < n; ++right)
      dp[left][right] = text[left] == text[right]
          ? 2 + (right - left == 1 ? 0 : dp[left + 1][right - 1])
          : std::max(dp[left + 1][right], dp[left][right - 1]);
  }
  return dp[0][n - 1];
}
