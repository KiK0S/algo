struct TreeHasher {
  std::map<std::vector<int>, int> ids;

  int rooted_hash(const std::vector<std::vector<int>>& graph, int root) {
    return rooted_hash_dfs(graph, root, -1);
  }

  std::pair<int, int> hash(const std::vector<std::vector<int>>& graph) {
    if (graph.empty()) return {0, 0};
    auto centers = tree_centers(graph);
    int first = rooted_hash(graph, centers[0]);
    int second = centers.size() == 1 ? first : rooted_hash(graph, centers[1]);
    if (first > second) std::swap(first, second);
    return {first, second};
  }

 private:
  int rooted_hash_dfs(const std::vector<std::vector<int>>& graph, int node, int parent) {
    std::vector<int> children;
    for (int next : graph[node]) {
      if (next != parent) children.push_back(rooted_hash_dfs(graph, next, node));
    }
    std::sort(children.begin(), children.end());
    auto [it, inserted] = ids.emplace(children, int(ids.size()) + 1);
    return it->second;
  }

  static std::vector<int> tree_centers(const std::vector<std::vector<int>>& graph) {
    int n = graph.size();
    if (n <= 2) {
      std::vector<int> centers(n);
      std::iota(centers.begin(), centers.end(), 0);
      return centers;
    }
    std::vector<int> degree(n);
    std::queue<int> leaves;
    for (int node = 0; node < n; ++node) {
      degree[node] = graph[node].size();
      if (degree[node] <= 1) leaves.push(node);
    }
    int remaining = n;
    while (remaining > 2) {
      int layer_size = leaves.size();
      remaining -= layer_size;
      while (layer_size--) {
        int node = leaves.front();
        leaves.pop();
        for (int next : graph[node]) {
          if (--degree[next] == 1) leaves.push(next);
        }
      }
    }
    std::vector<int> centers;
    while (!leaves.empty()) {
      centers.push_back(leaves.front());
      leaves.pop();
    }
    return centers;
  }
};
