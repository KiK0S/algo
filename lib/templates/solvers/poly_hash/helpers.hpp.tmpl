struct PolyHashValue {
  int first;
  int second;

  PolyHashValue(int first_ = 0, int second_ = 0)
      : first(first_), second(second_) {}
};

inline bool operator==(const PolyHashValue& lhs, const PolyHashValue& rhs) {
  return lhs.first == rhs.first && lhs.second == rhs.second;
}

inline bool operator!=(const PolyHashValue& lhs, const PolyHashValue& rhs) {
  return !(lhs == rhs);
}

inline bool operator<(const PolyHashValue& lhs, const PolyHashValue& rhs) {
  if (lhs.first != rhs.first) {
    return lhs.first < rhs.first;
  }
  return lhs.second < rhs.second;
}

class PolyHash {
 public:
  explicit PolyHash(const std::string& text = std::string(), int base = POLY_HASH_BASE) {
    build(text, base);
  }

  explicit PolyHash(const std::vector<int>& values, int base = POLY_HASH_BASE) {
    build(values, base);
  }

  void build(const std::string& text, int base = POLY_HASH_BASE) {
    std::vector<int> values;
    values.reserve(text.size());
    for (unsigned char ch : text) {
      values.push_back(static_cast<int>(ch));
    }
    build_values(values, base);
  }

  void build(const std::vector<int>& values, int base = POLY_HASH_BASE) {
    build_values(values, base);
  }

  int size() const { return static_cast<int>(prefix1_.size()) - 1; }

  int base() const { return base_; }

  PolyHashValue hash_prefix(int length) const {
    return hash_substring(0, length);
  }

  PolyHashValue hash_substring(int left, int right) const {
    const int n = size();
    if (left < 0) {
      left = 0;
    }
    if (right > n) {
      right = n;
    }
    if (left >= right) {
      return PolyHashValue(0, 0);
    }
    return range_hash(prefix1_, prefix2_, left, right);
  }

{{#if reverseFeature}}
  PolyHashValue reverse_hash_substring(int left, int right) const {
    const int n = size();
    if (left < 0) {
      left = 0;
    }
    if (right > n) {
      right = n;
    }
    if (left >= right) {
      return PolyHashValue(0, 0);
    }
    return range_hash(reverse_prefix1_, reverse_prefix2_, n - right, n - left);
  }

  bool is_palindrome(int left, int right) const {
    return hash_substring(left, right) == reverse_hash_substring(left, right);
  }
{{/if}}

  std::vector<PolyHashValue> all_hashes_of_length(int length) const {
    const int n = size();
    if (length < 0 || length > n) {
      return {};
    }
    std::vector<PolyHashValue> hashes;
    hashes.reserve(n - length + 1);
    for (int i = 0; i + length <= n; ++i) {
      hashes.push_back(hash_substring(i, i + length));
    }
    return hashes;
  }

{{#if equalFeature}}
  bool equal_substrings(int left1, int right1, int left2, int right2) const {
    if (right1 - left1 != right2 - left2) {
      return false;
    }
    return hash_substring(left1, right1) == hash_substring(left2, right2);
  }
{{/if}}

{{#if concatFeature}}
  PolyHashValue concat(const PolyHashValue& left,
                         const PolyHashValue& right, int right_length) const {
    if (right_length < 0 || right_length >= static_cast<int>(power1_.size())) {
      return PolyHashValue(0, 0);
    }

    const int merged1 =
        static_cast<int>((static_cast<long long>(left.first) * power1_[right_length] +
                          right.first) % POLY_HASH_MOD1);
    const int merged2 =
        static_cast<int>((static_cast<long long>(left.second) * power2_[right_length] +
                          right.second) % POLY_HASH_MOD2);
    return PolyHashValue(merged1, merged2);
  }
{{/if}}

{{#if lcpFeature}}
  int lcp(int left1, int left2, int limit = -1) const {
    const int n = size();
    if (left1 < 0 || left2 < 0 || left1 >= n || left2 >= n) {
      return 0;
    }
    int high = std::min(n - left1, n - left2);
    if (limit >= 0 && limit < high) {
      high = limit;
    }
    int low = 0;
    while (low < high) {
      const int mid = (low + high + 1) / 2;
      if (hash_substring(left1, left1 + mid) == hash_substring(left2, left2 + mid)) {
        low = mid;
      } else {
        high = mid - 1;
      }
    }
    return low;
  }
{{/if}}

 private:
  int base_;
  int base_mod1_;
  int base_mod2_;
  std::vector<int> prefix1_;
  std::vector<int> prefix2_;
  std::vector<int> power1_;
  std::vector<int> power2_;
{{#if reverseFeature}}
  std::vector<int> reverse_prefix1_;
  std::vector<int> reverse_prefix2_;
{{/if}}

  static int normalize_mod(long long value, int mod) {
    long long x = value % mod;
    if (x < 0) {
      x += mod;
    }
    return static_cast<int>(x);
  }

  PolyHashValue range_hash(const std::vector<int>& prefix1,
                            const std::vector<int>& prefix2,
                            int left, int right) const {
    const int len = right - left;
    int value1 =
        prefix1[right] -
        static_cast<int>((static_cast<long long>(prefix1[left]) * power1_[len]) % POLY_HASH_MOD1);
    if (value1 < 0) {
      value1 += POLY_HASH_MOD1;
    }

    int value2 =
        prefix2[right] -
        static_cast<int>((static_cast<long long>(prefix2[left]) * power2_[len]) % POLY_HASH_MOD2);
    if (value2 < 0) {
      value2 += POLY_HASH_MOD2;
    }

    return PolyHashValue(value1, value2);
  }

  int choose_base(int base) {
    int mod1 = normalize_mod(base, POLY_HASH_MOD1);
    int mod2 = normalize_mod(base, POLY_HASH_MOD2);
    if (mod1 <= 1 || mod2 <= 1) {
      base = POLY_HASH_BASE;
      mod1 = normalize_mod(base, POLY_HASH_MOD1);
      mod2 = normalize_mod(base, POLY_HASH_MOD2);
    }
    base_mod1_ = mod1;
    base_mod2_ = mod2;
    return base;
  }

  void push_prefix_value(long long raw_value, std::vector<int>& prefix1,
                         std::vector<int>& prefix2) const {
    const int value1 = normalize_mod(raw_value + 1, POLY_HASH_MOD1);
    const int value2 = normalize_mod(raw_value + 1, POLY_HASH_MOD2);
    prefix1.push_back(
        static_cast<int>((static_cast<long long>(prefix1.back()) * base_mod1_ + value1) % POLY_HASH_MOD1));
    prefix2.push_back(
        static_cast<int>((static_cast<long long>(prefix2.back()) * base_mod2_ + value2) % POLY_HASH_MOD2));
  }

  template <typename Container>
  void build_values(const Container& values, int base) {
    base_ = choose_base(base);
    const int n = static_cast<int>(values.size());

    prefix1_.assign(1, 0);
    prefix2_.assign(1, 0);
    power1_.assign(n + 1, 1);
    power2_.assign(n + 1, 1);
{{#if reverseFeature}}
    reverse_prefix1_.assign(1, 0);
    reverse_prefix2_.assign(1, 0);
{{/if}}

    for (int i = 0; i < n; ++i) {
      power1_[i + 1] = static_cast<int>((static_cast<long long>(power1_[i]) * base_mod1_) % POLY_HASH_MOD1);
      power2_[i + 1] = static_cast<int>((static_cast<long long>(power2_[i]) * base_mod2_) % POLY_HASH_MOD2);
      push_prefix_value(static_cast<long long>(values[i]), prefix1_, prefix2_);
    }

{{#if reverseFeature}}
    for (int i = n - 1; i >= 0; --i) {
      push_prefix_value(static_cast<long long>(values[i]), reverse_prefix1_, reverse_prefix2_);
    }
{{/if}}
  }
};

{{#if vectorInput}}
inline PolyHashValue poly_hash_vector(const std::vector<int>& values,
                                      int base = POLY_HASH_BASE) {
  PolyHash hash(values, base);
  return hash.hash_prefix(static_cast<int>(values.size()));
}
{{else}}
inline PolyHashValue poly_hash_string(const std::string& text,
                                      int base = POLY_HASH_BASE) {
  PolyHash hash(text, base);
  return hash.hash_prefix(static_cast<int>(text.size()));
}
{{/if}}

{{#if equalFeature}}
inline bool poly_hash_equal_substrings(const PolyHash& lhs,
                                       int left1, int right1,
                                       const PolyHash& rhs,
                                       int left2, int right2) {
  if (lhs.base() != rhs.base() || right1 - left1 != right2 - left2) {
    return false;
  }
  return lhs.hash_substring(left1, right1) == rhs.hash_substring(left2, right2);
}
{{/if}}
