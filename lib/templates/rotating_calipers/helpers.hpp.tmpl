template <typename T>
struct CalipersPoint { T x{}, y{}; };

template <typename T>
inline auto convex_polygon_diameter_squared(const std::vector<CalipersPoint<T>>& polygon) {
  using R = decltype(T{} * T{} + T{} * T{});
  const int n = polygon.size();
  if (n < 2) return R{};
  auto cross = [&](int a, int b, int c) { return std::abs((polygon[b].x - polygon[a].x) * (polygon[c].y - polygon[a].y) - (polygon[b].y - polygon[a].y) * (polygon[c].x - polygon[a].x)); };
  auto distance = [&](int a, int b) -> R { auto x = polygon[a].x - polygon[b].x, y = polygon[a].y - polygon[b].y; return x * x + y * y; };
  R answer{}; int opposite = 1;
  for (int edge = 0; edge < n; ++edge) {
    const int next = (edge + 1) % n;
    while (cross(edge, next, (opposite + 1) % n) > cross(edge, next, opposite)) opposite = (opposite + 1) % n;
    answer = std::max({answer, distance(edge, opposite), distance(next, opposite)});
  }
  return answer;
}

template <typename T>
inline long double convex_polygon_minimum_width(const std::vector<CalipersPoint<T>>& polygon) {
  const int n = polygon.size(); if (n < 3) return 0;
  int opposite = 1; long double answer = std::numeric_limits<long double>::infinity();
  for (int edge = 0; edge < n; ++edge) {
    const int next = (edge + 1) % n;
    auto twice_area = [&](int point) { return std::abs(static_cast<long double>(polygon[next].x - polygon[edge].x) * (polygon[point].y - polygon[edge].y) - static_cast<long double>(polygon[next].y - polygon[edge].y) * (polygon[point].x - polygon[edge].x)); };
    while (twice_area((opposite + 1) % n) > twice_area(opposite)) opposite = (opposite + 1) % n;
    const long double edge_length = std::hypotl(
        static_cast<long double>(polygon[next].x - polygon[edge].x),
        static_cast<long double>(polygon[next].y - polygon[edge].y));
    if (edge_length > 0)
      answer = std::min(answer, twice_area(opposite) / edge_length);
  }
  return std::isfinite(answer) ? answer : 0;
}

template <typename T>
inline auto convex_polygon_maximum_triangle_twice_area(const std::vector<CalipersPoint<T>>& polygon) {
  using R = decltype(T{} * T{} - T{} * T{});
  const int n = polygon.size(); R answer{};
  auto area = [&](int a, int b, int c) { return std::abs((polygon[b].x - polygon[a].x) * (polygon[c].y - polygon[a].y) - (polygon[b].y - polygon[a].y) * (polygon[c].x - polygon[a].x)); };
  for (int a = 0; a < n; ++a) {
    int c = (a + 2) % n;
    for (int offset = 1; offset + 1 < n; ++offset) {
      int b = (a + offset) % n;
      if (c == b) c = (c + 1) % n;
      while ((c + 1) % n != a && area(a, b, (c + 1) % n) >= area(a, b, c)) c = (c + 1) % n;
      answer = std::max(answer, area(a, b, c));
    }
  }
  return answer;
}

template <typename T>
inline long double convex_polygon_minimum_bounding_rectangle_area(const std::vector<CalipersPoint<T>>& polygon) {
  const int n = polygon.size(); if (n < 3) return 0;
  long double answer = std::numeric_limits<long double>::infinity();
  for (int i = 0; i < n; ++i) {
    long double dx = polygon[(i + 1) % n].x - polygon[i].x;
    long double dy = polygon[(i + 1) % n].y - polygon[i].y;
    long double length = hypotl(dx, dy); if (length == 0) continue;
    long double min_along = std::numeric_limits<long double>::infinity();
    long double max_along = -std::numeric_limits<long double>::infinity();
    long double min_across = std::numeric_limits<long double>::infinity();
    long double max_across = -std::numeric_limits<long double>::infinity();
    for (auto point : polygon) {
      long double along = (point.x * dx + point.y * dy) / length;
      long double across = (-point.x * dy + point.y * dx) / length;
      min_along = std::min(min_along, along); max_along = std::max(max_along, along);
      min_across = std::min(min_across, across); max_across = std::max(max_across, across);
    }
    answer = std::min(answer, (max_along - min_along) * (max_across - min_across));
  }
  return std::isfinite(answer) ? answer : 0;
}
